@model List<WebIde.Model.Problem>
@if (Model.Count == 0)
{
    <tr>
        <td colspan="5" class="text-center py-4 text-outline font-bold text-xs uppercase tracking-widest"
            style="font-family:'Space Grotesk',sans-serif;">NO_RESULTS</td>
    </tr>
}
else
{
    foreach (var problem in Model)
    {
        @await Html.PartialAsync("_ProblemRow", problem)
    }
}
