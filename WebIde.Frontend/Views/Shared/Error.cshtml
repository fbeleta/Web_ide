@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="flex justify-center px-4 pt-28 pb-12">
    <div class="brutal-card hard-shadow-lg w-full max-w-lg">
        <h1 class="font-headline text-4xl font-black uppercase mb-2 tracking-tight text-red-600">ERROR_</h1>
        <p class="font-body text-sm text-gray-600 mb-6">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="font-mono text-xs mb-6">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index"
           class="inline-block bg-[#2752c7] text-[#f1f2ff] font-headline font-black uppercase text-sm px-6 py-4
                  hard-shadow hard-shadow-hover brutal-border tracking-widest no-underline">
            Back to home
        </a>
    </div>
</div>
