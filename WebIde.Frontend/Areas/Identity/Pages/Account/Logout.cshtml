@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="flex justify-center px-4 pt-28 pb-12">
    <div class="brutal-card hard-shadow-lg w-full max-w-md text-center">
        <h1 class="font-headline text-3xl font-black uppercase mb-2 tracking-tight">LOGGED_OUT_</h1>
        <p class="font-body text-sm text-gray-500 mb-8">You have been signed out.</p>
        <a asp-controller="Home" asp-action="Index"
           class="inline-block bg-[#2752c7] text-[#f1f2ff] font-headline font-black uppercase text-sm px-6 py-4
                  hard-shadow hard-shadow-hover brutal-border tracking-widest no-underline">
            Back to home
        </a>
    </div>
</div>
