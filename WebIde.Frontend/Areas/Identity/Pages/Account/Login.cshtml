@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="flex justify-center px-4 pt-28 pb-12">
    <div class="brutal-card hard-shadow-lg w-full max-w-md">
        <h1 class="font-headline text-3xl font-black uppercase mb-2 tracking-tight">LOGIN_</h1>
        <p class="font-body text-sm text-gray-500 mb-8">Sign in to compete.</p>

        <form method="post" class="flex flex-col gap-5">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-bold"></div>

            <div>
                <label asp-for="Input.Email" class="block font-bold mb-1"></label>
                <input asp-for="Input.Email" autocomplete="username"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block font-bold mb-1"></label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
            </div>

            <button type="submit"
                    class="bg-black text-white font-headline font-black uppercase text-sm px-6 py-4
                           hard-shadow hard-shadow-hover brutal-border tracking-widest w-full">
                Log in
            </button>
        </form>

        <p class="font-body text-sm mt-6">
            Need an account?
            <a asp-page="Register" class="font-bold underline">Register</a>
        </p>

        <div class="flex items-center gap-3 my-8">
            <div class="flex-1 h-0.5 bg-black"></div>
            <span class="font-headline font-black uppercase text-xs tracking-widest text-gray-500">or</span>
            <div class="flex-1 h-0.5 bg-black"></div>
        </div>

        @* GitHub uses this app's own OAuth flow (AuthController → /auth/github/login),
           NOT Identity's ExternalLogin handler — the GitHub scheme has its own cookie
           and user-upsert and is not wired as an Identity external provider. *@
        <a asp-controller="Auth" asp-action="Login"
           class="bg-[#2752c7] text-[#f1f2ff] font-headline font-black uppercase text-sm px-6 py-4 hard-shadow hard-shadow-hover brutal-border tracking-widest w-full block text-center no-underline">
            GitHub Login
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
