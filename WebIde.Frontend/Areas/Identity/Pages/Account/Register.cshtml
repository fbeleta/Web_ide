@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex justify-center px-4 pt-28 pb-12">
    <div class="brutal-card hard-shadow-lg w-full max-w-md">
        <h1 class="font-headline text-3xl font-black uppercase mb-2 tracking-tight">REGISTER_</h1>
        <p class="font-body text-sm text-gray-500 mb-8">Create an account to compete.</p>

        <form method="post" class="flex flex-col gap-5">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-bold"></div>

            <div>
                <label asp-for="Input.Email" class="block font-bold mb-1"></label>
                <input asp-for="Input.Email" autocomplete="username"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block font-bold mb-1"></label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block font-bold mb-1"></label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.OIB" class="block font-bold mb-1"></label>
                <input asp-for="Input.OIB" maxlength="11"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.OIB" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.JMBG" class="block font-bold mb-1"></label>
                <input asp-for="Input.JMBG" maxlength="13"
                       class="w-full border-2 border-black px-3 py-2 font-mono focus:outline-none" />
                <span asp-validation-for="Input.JMBG" class="text-red-600 text-sm"></span>
            </div>

            <button type="submit"
                    class="bg-[#2752c7] text-[#f1f2ff] font-headline font-black uppercase text-sm px-6 py-4
                           hard-shadow hard-shadow-hover brutal-border tracking-widest w-full">
                Register
            </button>
        </form>

        <p class="font-body text-sm mt-6">
            Already have an account?
            <a asp-page="Login" class="font-bold underline">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
